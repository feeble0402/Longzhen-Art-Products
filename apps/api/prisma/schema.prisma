generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PriceMode {
  PUBLIC_PRICE
  LINE_OFFER
  CONTACT_PRICE
}

enum SaleStatus {
  ON_SALE
  SOLD_OUT
  PAUSED
  DRAFT
  UNLISTED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGIN_FAILED
  PASSWORD_RESET
}

model Admin {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.VarChar(320)
  displayName       String     @db.VarChar(100)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  active            Boolean    @default(true)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs         AuditLog[]

  @@map("admins")
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  adminId    String?     @map("admin_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(80)
  entityId   String?     @map("entity_id") @db.VarChar(80)
  metadata   Json?
  ipAddress  String?     @map("ip_address") @db.Inet
  userAgent  String?     @map("user_agent") @db.VarChar(500)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  admin      Admin?      @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Product {
  id                   String                  @id @default(uuid()) @db.Uuid
  sku                  String                  @unique @db.VarChar(64)
  slug                 String                  @unique @db.VarChar(160)
  name                 String                  @db.VarChar(200)
  shortDescription     String                  @map("short_description") @db.VarChar(500)
  description          String                  @db.Text
  specifications       Json?
  notices              String?                 @db.Text
  originalPrice        Decimal?                @map("original_price") @db.Decimal(12, 2)
  salePrice            Decimal?                @map("sale_price") @db.Decimal(12, 2)
  priceMode            PriceMode               @map("price_mode")
  saleStatus           SaleStatus              @default(DRAFT) @map("sale_status")
  shopeeUrl            String?                 @map("shopee_url") @db.VarChar(2048)
  acceptsShopee        Boolean                 @default(false) @map("accepts_shopee")
  acceptsLine          Boolean                 @default(true) @map("accepts_line")
  lineInquiryTemplate  String?                 @map("line_inquiry_template") @db.Text
  showOnHome           Boolean                 @default(false) @map("show_on_home")
  homeSortOrder        Int?                    @map("home_sort_order")
  isNew                Boolean                 @default(false) @map("is_new")
  isFeatured           Boolean                 @default(false) @map("is_featured")
  isBestSeller         Boolean                 @default(false) @map("is_best_seller")
  isPrimary            Boolean                 @default(false) @map("is_primary")
  showSoldOutInRelated Boolean                 @default(false) @map("show_sold_out_in_related")
  publishedAt          DateTime?               @map("published_at") @db.Timestamptz(3)
  unpublishAt          DateTime?               @map("unpublish_at") @db.Timestamptz(3)
  seoTitle             String?                 @map("seo_title") @db.VarChar(70)
  seoDescription       String?                 @map("seo_description") @db.VarChar(170)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories           ProductCategory[]
  images               ProductImage[]
  tags                 ProductTag[]
  recommendations      ProductRecommendation[] @relation("RecommendationSource")
  recommendedBy        ProductRecommendation[] @relation("RecommendationTarget")

  @@index([saleStatus, publishedAt(sort: Desc)])
  @@index([priceMode, salePrice])
  @@index([showOnHome, homeSortOrder])
  @@map("products")
}

model Category {
  id             String            @id @default(uuid()) @db.Uuid
  parentId       String?           @map("parent_id") @db.Uuid
  name           String            @db.VarChar(120)
  slug           String            @unique @db.VarChar(160)
  description    String?           @db.VarChar(500)
  imageKey       String?           @map("image_key") @db.VarChar(500)
  sortOrder      Int               @default(0) @map("sort_order")
  active         Boolean           @default(true)
  seoTitle       String?           @map("seo_title") @db.VarChar(70)
  seoDescription String?           @map("seo_description") @db.VarChar(170)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]        @relation("CategoryTree")
  products       ProductCategory[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_categories")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  objectKey String   @map("object_key") @db.VarChar(500)
  altText   String   @map("alt_text") @db.VarChar(250)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  byteSize  Int      @map("byte_size")
  width     Int
  height    Int
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model Tag {
  id       String       @id @default(uuid()) @db.Uuid
  name     String       @unique @db.VarChar(80)
  slug     String       @unique @db.VarChar(100)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductRecommendation {
  sourceProductId String   @map("source_product_id") @db.Uuid
  targetProductId String   @map("target_product_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sourceProduct   Product  @relation("RecommendationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct   Product  @relation("RecommendationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@id([sourceProductId, targetProductId])
  @@index([sourceProductId, sortOrder])
  @@map("product_recommendations")
}

model Page {
  id             String         @id @default(uuid()) @db.Uuid
  key            String         @unique @db.VarChar(80)
  title          String         @db.VarChar(200)
  slug           String         @unique @db.VarChar(160)
  status         PublishStatus  @default(DRAFT)
  seoTitle       String?        @map("seo_title") @db.VarChar(70)
  seoDescription String?        @map("seo_description") @db.VarChar(170)
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  blocks         ContentBlock[]

  @@index([status, publishedAt])
  @@map("pages")
}

model ContentBlock {
  id             String   @id @default(uuid()) @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  type           String   @db.VarChar(80)
  content        Json
  sortOrder      Int      @default(0) @map("sort_order")
  visible        Boolean  @default(true)
  desktopOptions Json?    @map("desktop_options")
  mobileOptions  Json?    @map("mobile_options")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  page           Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sortOrder])
  @@map("content_blocks")
}

model FaqCategory {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(120)
  slug      String  @unique @db.VarChar(160)
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  faqs      Faq[]

  @@map("faq_categories")
}

model Faq {
  id         String        @id @default(uuid()) @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  question   String        @db.VarChar(300)
  answer     Json
  sortOrder  Int           @default(0) @map("sort_order")
  status     PublishStatus @default(DRAFT)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  category   FaqCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, status, sortOrder])
  @@map("faqs")
}

model CarouselSlide {
  id          String    @id @default(uuid()) @db.Uuid
  desktopKey  String    @map("desktop_key") @db.VarChar(500)
  mobileKey   String    @map("mobile_key") @db.VarChar(500)
  title       String?   @db.VarChar(200)
  subtitle    String?   @db.VarChar(300)
  buttonLabel String?   @map("button_label") @db.VarChar(80)
  targetUrl   String?   @map("target_url") @db.VarChar(2048)
  sortOrder   Int       @default(0) @map("sort_order")
  active      Boolean   @default(true)
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active, sortOrder])
  @@map("carousel_slides")
}

model SiteSetting {
  key         String   @id @db.VarChar(120)
  value       Json
  description String?  @db.VarChar(300)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}
